# ==============================================================================
# TaskSync Environment Configuration Example
# Copy this file to .env and adjust values for local development
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=tasksync_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/tasksync_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_min_32_characters_for_tasksync_dev
JWT_EXPIRES_IN=7d

# CORS & Client URLs
CLIENT_URL=http://localhost:5173

# Notification Service & Mailpit (Local SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="TaskSync <noreply@tasksync.local>"
MAILPIT_WEB_PORT=8025
